# Copy this file to .env, fill in your own Supabase project's values
# (Project Settings -> API in the Supabase dashboard), then rebuild/redeploy.
#
# Leave these unset (or delete .env) to run the app with no login gate —
# useful for local development.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Free API key from accounts.openaip.net (API clients section) — adds
# airspace/airport/navaid/reporting-point overlay layers to the map. Leave
# unset to just not show those layer options.
VITE_OPENAIP_API_KEY=
